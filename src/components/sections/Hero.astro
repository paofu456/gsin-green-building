---
import Button from "../ui/Button.astro";

const slides = [
  {
    image: "/media/projects/bay-park-center.jpg",
    alt: "深湾汇云中心项目鸟瞰图",
    eyebrow: "钢结构专业承包",
    title: "深湾汇云中心",
    description: "画册记载的中国地铁上盖超高层建筑代表项目，位于中国深圳。",
    metrics: [
      { label: "建筑面积", value: "208028㎡" },
      { label: "建筑高度", value: "358.7米" },
      { label: "用钢量", value: "39548吨" },
    ],
    href: "/products/steel-structure-engineering/",
    vertical: "BAY PARK CENTER",
  },
  {
    image: "/media/projects/cumark-tower.jpg",
    alt: "库马克大厦装配式钢结构建筑鸟瞰图",
    eyebrow: "装配式建筑总承包",
    title: "库马克大厦",
    description: "广东省首批装配式建筑示范项目，体现EPC模式下的绿色建造能力。",
    metrics: [
      { label: "建筑面积", value: "38697㎡" },
      { label: "建筑高度", value: "76.4米" },
      { label: "地上层数", value: "17层" },
    ],
    href: "/products/prefabricated-steel-buildings/",
    vertical: "CUMARK TOWER",
  },
  {
    image: "/media/products/chenyuan-150.jpg",
    alt: "宸园150中式乡墅正面效果图",
    eyebrow: "金鑫乡墅产品",
    title: "宸园150·中式",
    description: "以重钢结构承托中式宅院气质，画册记载销售面积297平方米。",
    metrics: [
      { label: "销售面积", value: "297㎡" },
      { label: "占地面积", value: "150㎡" },
      { label: "建筑层数", value: "2层" },
    ],
    href: "/products/jinxin-country-houses/",
    vertical: "CHEN YUAN 150",
  },
];
---

<section
  aria-roledescription="carousel"
  aria-label="金鑫绿建代表项目"
  class="relative h-[calc(100vh-80px)] min-h-[760px] snap-start overflow-hidden bg-[var(--color-ink)] text-white"
>
  {slides.map((slide, index) => (
    <article
      data-hero-slide={index === 0 ? "active" : "inactive"}
      aria-hidden={index === 0 ? "false" : "true"}
      class="absolute inset-0"
    >
      <img src={slide.image} alt={slide.alt} width="1466" height="986" class="h-full w-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-r from-[#04121d]/88 via-[#04121d]/56 to-transparent" aria-hidden="true"></div>
      <div class="absolute inset-y-0 left-0 flex w-full max-w-[38rem] flex-col justify-center px-6 pb-24 sm:px-10 lg:px-16">
        <p class="mb-5 inline-flex w-fit items-center gap-3 bg-white/10 px-4 py-2 text-xs font-extrabold uppercase tracking-[0.2em] text-[var(--color-accent)]">
          {slide.eyebrow}
        </p>
        {index === 0 ? (
          <h1 class="text-5xl font-black leading-[1.02] xl:text-7xl">{slide.title}</h1>
        ) : (
          <h2 class="text-5xl font-black leading-[1.02] xl:text-7xl">{slide.title}</h2>
        )}
        <p class="mt-6 max-w-xl text-lg leading-8 text-white/75 xl:text-xl">{slide.description}</p>
        <dl class="mt-8 grid max-w-xl grid-cols-3 border-t border-white/20 pt-6">
          {slide.metrics.map((metric) => (
            <div class="pr-4">
              <dt class="text-xs font-bold uppercase tracking-[0.12em] text-white/60">{metric.label}</dt>
              <dd class="mt-2 text-xl font-black xl:text-2xl">{metric.value}</dd>
            </div>
          ))}
        </dl>
        <div class="mt-9">
          <Button href={slide.href} variant="custom" class="bg-white text-[var(--color-primary)] hover:bg-[var(--color-accent)] hover:text-[var(--color-ink)]">
            查看业务
          </Button>
        </div>
      </div>
      <p aria-hidden="true" class="absolute right-12 top-1/2 hidden -translate-y-1/2 text-sm font-black tracking-[0.4em] text-white/70 [writing-mode:vertical-rl] xl:block">
        {slide.vertical}
      </p>
    </article>
  ))}

  <div class="absolute bottom-8 left-1/2 z-10 flex -translate-x-1/2 items-center gap-4">
    <button type="button" data-hero-direction="-1" aria-label="上一组项目" class="flex h-11 w-11 items-center justify-center rounded-full border border-white/35 text-white transition hover:border-white hover:bg-white/15">
      <span aria-hidden="true">←</span>
    </button>
    <div class="flex items-center gap-2">
      {slides.map((slide, index) => (
        <button
          type="button"
          data-hero-dot={index}
          data-state={index === 0 ? "active" : "inactive"}
          aria-label={`查看第 ${index + 1} 组项目`}
          class="h-2 rounded-full bg-white/40 transition-all"
        >
          <span class="sr-only">{slide.title}</span>
        </button>
      ))}
    </div>
    <button type="button" data-hero-direction="1" aria-label="下一组项目" class="flex h-11 w-11 items-center justify-center rounded-full border border-white/35 text-white transition hover:border-white hover:bg-white/15">
      <span aria-hidden="true">→</span>
    </button>
  </div>
</section>

<script>
  const slides = [...document.querySelectorAll<HTMLElement>("[data-hero-slide]")];
  const dots = [...document.querySelectorAll<HTMLButtonElement>("[data-hero-dot]")];
  let current = 0;

  const showSlide = (next: number) => {
    current = (next + slides.length) % slides.length;
    slides.forEach((slide, index) => {
      const active = index === current;
      slide.dataset.heroSlide = active ? "active" : "inactive";
      slide.setAttribute("aria-hidden", String(!active));
    });
    dots.forEach((dot, index) => {
      dot.dataset.state = index === current ? "active" : "inactive";
      dot.setAttribute("aria-current", index === current ? "true" : "false");
    });
  };

  dots.forEach((dot) => dot.addEventListener("click", () => showSlide(Number(dot.dataset.heroDot))));
  document.querySelectorAll<HTMLButtonElement>("[data-hero-direction]").forEach((button) => {
    button.addEventListener("click", () => showSlide(current + Number(button.dataset.heroDirection)));
  });
</script>
