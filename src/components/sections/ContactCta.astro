---
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
---

<section class="min-h-[calc(100vh-80px)] snap-start bg-[var(--color-primary-dark)] py-24 sm:py-32">
  <Container>
    <div class="relative overflow-hidden rounded-[2rem] bg-[var(--color-primary)] px-6 py-14 text-white sm:px-12 lg:flex lg:items-center lg:justify-between lg:gap-12 lg:px-16 lg:py-16">
      <div class="absolute -right-20 -top-32 h-80 w-80 rounded-full border-[60px] border-white/10" aria-hidden="true"></div>
      <div class="relative max-w-3xl">
        <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-[var(--color-accent)]">合作沟通</p>
        <h2 class="mt-4 text-3xl font-extrabold leading-tight sm:text-5xl">欢迎咨询项目合作与乡墅产品方案。</h2>
        <p class="mt-5 text-lg text-white/75">请通过公开邮箱发送项目地点、建设需求、用地条件和联系方式，我们会尽快回复。</p>
      </div>
      <div class="relative mt-8 flex shrink-0 flex-col gap-3 sm:flex-row lg:mt-0 lg:flex-col">
        <Button href="/contact/" variant="custom" class="bg-white text-[var(--color-primary)] hover:bg-[var(--color-accent)]">前往联系询盘</Button>
      </div>
    </div>
  </Container>
</section>
