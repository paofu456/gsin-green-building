---
import Button from "../ui/Button.astro";
import company from "../../data/company.json";
---

<section class="grid min-h-[calc(100vh-80px)] snap-start bg-white lg:grid-cols-2">
  <div class="relative min-h-[420px] overflow-hidden">
    <img src="/media/projects/highrise-tower.jpg" alt="金鑫绿建参与建设的超高层钢结构建筑" width="744" height="825" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute bottom-8 left-6 bg-white p-6 shadow-xl sm:left-10">
      <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-[var(--color-primary)]">Since</p>
      <p class="mt-2 text-4xl font-black text-[var(--color-ink)]">1998</p>
    </div>
  </div>

  <div class="flex items-center px-6 py-20 sm:px-10 lg:px-16">
    <div class="max-w-3xl">
      <p class="eyebrow">公司介绍</p>
      <h2 class="mt-6 text-4xl font-black leading-[1.1] text-[var(--color-ink)] xl:text-6xl">
        以工程总承包能力<br />构建绿色建筑产品体系
      </h2>
      <p class="mt-7 text-xl leading-9 text-[var(--color-muted)]">{company.description}</p>
      <dl class="mt-10 grid grid-cols-2 gap-6 border-t border-[var(--color-line)] pt-8 xl:grid-cols-4">
        {[
          { label: "超高层项目", value: "72个" },
          { label: "大跨度项目", value: "62个" },
          { label: "装配式项目", value: "12个" },
          { label: "项目覆盖", value: "80+城" },
        ].map((item) => (
          <div>
            <dd class="text-3xl font-black text-[var(--color-primary)] xl:text-4xl">{item.value}</dd>
            <dt class="mt-2 text-sm font-bold text-[var(--color-muted)]">{item.label}</dt>
          </div>
        ))}
      </dl>
      <Button href="/about/" variant="custom" class="mt-10 bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-dark)]">
        查看公司实力
      </Button>
    </div>
  </div>
</section>
